# Cole a URL e a chave PUBLICÁVEL do projeto (Settings → API Keys).
# A chave publicável é segura no navegador: quem manda é o RLS do banco.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# NUNCA coloque a SECRET_KEY aqui nem na Vercel do app: ela ignora o RLS.
# Ela só vai nos secrets da Edge Function (supabase secrets set).
